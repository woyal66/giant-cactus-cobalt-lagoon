# Copy to .env.production.local (git-ignored) and fill in before `npm run build:mobile`.
# These are RevenueCat *public* SDK keys (they start with appl_ / goog_). They are
# meant to ship inside the app; they are not secrets. Never put a RevenueCat
# secret key (sk_...) here.
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# Entitlement identifier configured in RevenueCat (default "pro").
VITE_RC_ENTITLEMENT=pro

# Set to 1 to see the paywall in a desktop browser with sample prices.
# VITE_PAYWALL_PREVIEW=1

# ---- Map and weather data licences (see STORE-RELEASE.md, "Map and weather data") ----
# MapTiler Satellite: licensed imagery that may be saved on the phone for offline packs.
# VITE_MAPTILER_KEY=
# Esri World Imagery via ArcGIS Location Platform (licensed, keyed endpoint).
# VITE_ESRI_KEY=
# Open-Meteo commercial API key (the free API is non-commercial only).
# VITE_OPEN_METEO_KEY=
# Set to 1 for the store build: hides map sources that have no commercial licence
# (Google, Bing, keyless Esri/Clarity, Sentinel-2 2024).
# VITE_LICENSED_IMAGERY_ONLY=1

# ---- Remote watch ----
# ntfy server for second-phone alerts. The public https://ntfy.sh works for testing
# but is rate-limited; use a paid ntfy plan or a self-hosted server for launch.
# VITE_REMOTE_WATCH_SERVER=https://ntfy.sh
